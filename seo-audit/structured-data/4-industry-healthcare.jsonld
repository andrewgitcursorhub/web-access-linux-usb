          "@type": "DefinedTerm",
          "@id": "https://core-asset-sol.com/#term-hipaa",
          "name": "HIPAA Security Rule",
          "description": "United States regulation establishing national standards for protecting electronic protected health information, including requirements for the disposal of media containing ePHI.",
          "url": "https://www.hhs.gov/hipaa/for-professionals/security/index.html",
          "inDefinedTermSet": {
            "@type": "DefinedTermSet",
