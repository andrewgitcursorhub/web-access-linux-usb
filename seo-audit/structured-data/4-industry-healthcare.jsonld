      "_comment_compliance": [
        "THE HEALTHCARE-SPECIFIC REGIME. This block is what differs from every other industry",
        "page. On /financial-services it becomes GLBA + PCI DSS + SOX; on /education, FERPA;",
        "on /government, FISMA + NIST 800-171.",
        "",
        "Claim only what you actually do. 'HIPAA compliant' is a phrase to avoid — no vendor is",
        "certified HIPAA compliant, because HIPAA has no certification body. 'HIPAA-aligned' and",
        "'supports your HIPAA compliance obligations' are accurate and defensible. Note the",
        "Business Associate Agreement entry: for a healthcare buyer that is often the single",
        "most important procurement question, and almost no competitor states it in markup."
      ],
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Primary regulatory framework", "value": "HIPAA Security Rule (45 CFR Part 164 Subpart C)" },
        { "@type": "PropertyValue", "name": "Secondary regulatory framework", "value": "HITECH Act breach notification requirements" },
        { "@type": "PropertyValue", "name": "Sanitization standard", "value": "NIST SP 800-88 Rev. 2 Purge and Destroy for PHI-bearing media" },
        { "@type": "PropertyValue", "name": "Business Associate Agreement", "value": "BAA executed prior to engagement" },
        { "@type": "PropertyValue", "name": "PHI handling", "value": "Serialized chain of custody from point of collection through verified sanitization" },
        { "@type": "PropertyValue", "name": "Documentation provided", "value": "Certificate of Destruction and Certificate of Media Sanitization, formatted for HIPAA audit evidence" },
        { "@type": "PropertyValue", "name": "Specialty equipment handled", "value": "Imaging systems (MRI, CT, ultrasound), infusion pumps, patient monitors, laboratory instruments and embedded-storage medical devices" },
        { "@type": "PropertyValue", "name": "On-site service available", "value": "Yes — sanitization and destruction can be performed at the hospital or clinic facility" }
      ],

