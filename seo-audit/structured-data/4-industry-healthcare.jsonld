          "@type": "DefinedTerm",
          "@id": "https://core-asset-sol.com/#term-hitech",
          "name": "HITECH Act",
          "description": "Health Information Technology for Economic and Clinical Health Act, which strengthened HIPAA enforcement and established breach notification requirements for unsecured protected health information.",
          "url": "https://www.hhs.gov/hipaa/for-professionals/special-topics/hitech-act-enforcement-interim-final-rule/index.html",
          "inDefinedTermSet": {
