      "mainEntity": { "@id": "https://core-asset-sol.com/services#service-list" },
      "inLanguage": "en-US",

      "_comment_provider": "Ties this hub page to the business entity, so the page carries local signals instead of floating free.",
      "provider": { "@id": "https://core-asset-sol.com/#organization" }
    },

    {
      "@type": "BreadcrumbList",
      "@id": "https://core-asset-sol.com/services#breadcrumb",
