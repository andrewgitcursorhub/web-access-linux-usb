    {
      "@type": "WebSite",
      "@id": "https://core-asset-sol.com/#website",
      "url": "https://core-asset-sol.com/",
      "name": "Core Asset Solutions",
      "inLanguage": "en-US",
      "publisher": { "@id": "https://core-asset-sol.com/#organization" }
    },

    {
      "_comment_image": [
        "_ADDED_ Per-page hero image, declared as a first-class ImageObject with its own @id so",
        "both the page and the collection can reference it.",
        "",
        "Your live og:image on THIS page (and every other page) is the company logo. That is a",
        "miss — you already have a purpose-built hero here. Point og:image at this same file.",
        "",
        "SIZE WARNING: the current file is 848x565 and 521 KB. Google wants large images for",
        "image-bearing results (1200px+ on the long edge is the working target), and 521 KB of",
        "PNG for that pixel count is very heavy. Re-export at 1200x630 as WebP — you will get a",
        "bigger image at roughly a fifth of the weight. Update width/height here when you do."
      ],
      "@type": "ImageObject",
      "@id": "https://core-asset-sol.com/services#primaryimage",
      "url": "https://core-asset-sol.com/assets/industries-services-hero/services-overview-hero.png",
      "contentUrl": "https://core-asset-sol.com/assets/industries-services-hero/services-overview-hero.png",
      "width": 848,
      "height": 565,
      "caption": "Core Asset Solutions IT asset disposition and electronics recycling services",
      "representativeOfPage": true
    },

    {
      "@type": "CollectionPage",
      "@id": "https://core-asset-sol.com/services#webpage",
      "url": "https://core-asset-sol.com/services",
      "name": "Electronics Recycling Services & Enterprise ITAD Solutions",
      "description": "REPLACE_WITH_YOUR_UPDATED_META_DESCRIPTION — keep it identical to the <meta name=\"description\"> on the page.",
