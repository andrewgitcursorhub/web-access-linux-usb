      "_comment_compliance": [
        "COMPLIANCE AS STRUCTURED DATA — two complementary mechanisms:",
        "",
        "  additionalProperty  → flat, factual name/value pairs. Easy for any parser to read.",
        "  about → DefinedTerm  → real entities with authoritative URLs. This is the stronger",
        "                         signal, because it links your service to the actual published",
        "                         standard rather than to a keyword string.",
        "",
        "Use both. Only claim frameworks you genuinely operate against."
      ],
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Sanitization standard", "value": "NIST SP 800-88 Rev. 2" },
        { "@type": "PropertyValue", "name": "Sanitization methods", "value": "Clear, Purge, Destroy" },
        { "@type": "PropertyValue", "name": "Chain of custody", "value": "Serialized, item-level, from collection through final disposition" },
        { "@type": "PropertyValue", "name": "Documentation provided", "value": "Certificate of Destruction and Certificate of Media Sanitization" },
        { "@type": "PropertyValue", "name": "Supported compliance frameworks", "value": "HIPAA, SOC 2, PCI DSS, GDPR, CCPA, FISMA, NIST 800-171" },
        { "@type": "PropertyValue", "name": "On-site service available", "value": "Yes — sanitization and destruction can be performed at the client facility" }
      ],

