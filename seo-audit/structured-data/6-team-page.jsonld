      },
      "url": "https://core-asset-sol.com/about/team",
      "worksFor": { "@id": "https://core-asset-sol.com/#organization" },
      "sameAs": ["https://www.linkedin.com/in/REPLACE-person-two-handle"],
      "knowsAbout": ["REPLACE", "REPLACE"]
    },

