        "caption": "REPLACE_WITH_NAME, Core Asset Solutions"
      },
      "url": "https://core-asset-sol.com/about/team",
      "worksFor": { "@id": "https://core-asset-sol.com/#organization" },
      "sameAs": ["https://www.linkedin.com/in/REPLACE-person-three-handle"],
